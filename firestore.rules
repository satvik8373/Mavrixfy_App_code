rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function ownerFromCreatedBy(data) {
      return signedIn() &&
        data.keys().hasAny(['createdBy']) &&
        data.createdBy is map &&
        (
          (data.createdBy.keys().hasAny(['uid']) && data.createdBy.uid == request.auth.uid) ||
          (data.createdBy.keys().hasAny(['id']) && data.createdBy.id == request.auth.uid) ||
          (data.createdBy.keys().hasAny(['_id']) && data.createdBy._id == request.auth.uid)
        );
    }

    function userCreateFieldsAreValid(userId) {
      return (!request.resource.data.keys().hasAny(['uid']) || request.resource.data.uid == userId) &&
        (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role in ['user']) &&
        (!request.resource.data.keys().hasAny(['isAdmin']) || request.resource.data.isAdmin == false) &&
        (!request.resource.data.keys().hasAny(['admin']) || request.resource.data.admin == false);
    }

    function userAuthFieldsAreImmutable() {
      return (!resource.data.keys().hasAny(['uid']) || request.resource.data.uid == resource.data.uid) &&
        (!resource.data.keys().hasAny(['email']) || request.resource.data.email == resource.data.email) &&
        (!resource.data.keys().hasAny(['emailLower']) || request.resource.data.emailLower == resource.data.emailLower) &&
        (!resource.data.keys().hasAny(['provider']) || request.resource.data.provider == resource.data.provider) &&
        (!resource.data.keys().hasAny(['schemaVersion']) || request.resource.data.schemaVersion == resource.data.schemaVersion) &&
        (!resource.data.keys().hasAny(['role']) || request.resource.data.role == resource.data.role) &&
        (!resource.data.keys().hasAny(['isAdmin']) || request.resource.data.isAdmin == resource.data.isAdmin) &&
        (!resource.data.keys().hasAny(['admin']) || request.resource.data.admin == resource.data.admin);
    }

    function isPublicCatalogDocument(data) {
      return (!data.keys().hasAny(['visibility']) || data.visibility == 'public') &&
        (!data.keys().hasAny(['isPublic']) || data.isPublic == true) &&
        (!data.keys().hasAny(['status']) || data.status in ['published', 'active']) &&
        (
          data.keys().hasAny(['name']) ||
          data.keys().hasAny(['title']) ||
          data.keys().hasAny(['songId']) ||
          data.keys().hasAny(['albumId'])
        );
    }

    function isPublicPromotionDocument(data) {
      return (!data.keys().hasAny(['visibility']) || data.visibility == 'public') &&
        (!data.keys().hasAny(['isPublic']) || data.isPublic == true) &&
        (!data.keys().hasAny(['status']) || data.status in ['published', 'active']) &&
        (
          data.keys().hasAny(['title']) ||
          data.keys().hasAny(['message']) ||
          data.keys().hasAny(['imageUrl'])
        );
    }

    function isPublicAppVersion(data) {
      return data.keys().hasAll(['latestVersion', 'minimumVersion']);
    }

    match /admins/{adminId} {
      allow get: if isOwner(adminId) || isAdmin();
      allow list, create, update, delete: if isAdmin();
    }

    match /appVersions/{appId} {
      allow get: if isPublicAppVersion(resource.data);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && userCreateFieldsAreValid(userId);
      allow update: if isAdmin() || (isOwner(userId) && userAuthFieldsAreImmutable());
      allow delete: if isOwner(userId) || isAdmin();

      match /likedSongs/{songId} {
        allow read, create, update, delete: if isOwner(userId) || isAdmin();
      }

      match /pushTokens/{tokenId} {
        allow read, create, update, delete: if isOwner(userId) || isAdmin();
      }

      match /spotifyTokens/{tokenId} {
        allow read, create, update, delete: if isOwner(userId) || isAdmin();
      }

      match /spotifySync/{docId} {
        allow read, create, update, delete: if isOwner(userId) || isAdmin();
      }

      match /spotifyLikedSongs/{songId} {
        allow read, create, update, delete: if isOwner(userId) || isAdmin();
      }

      match /offlineLicenses/{songId} {
        allow read, create, update, delete: if isOwner(userId) || isAdmin();
      }

      match /downloadDevices/{deviceId} {
        allow read, create, update, delete: if isOwner(userId) || isAdmin();
      }

      match /activityFeed/{notifId} {
        allow read, create, update, delete: if isOwner(userId) || isAdmin();
      }
    }

    // Legacy mobile format. New clients must use users/{uid}/likedSongs/{songId}.
    match /likedSongs/{userId} {
      allow read, delete: if isOwner(userId) || isAdmin();
      allow create, update: if false;
    }

    match /playlists/{playlistId} {
      allow get, list: if resource.data.isPublic == true ||
        (signedIn() && ownerFromCreatedBy(resource.data)) ||
        isAdmin();
      allow create: if signedIn() &&
        ownerFromCreatedBy(request.resource.data);
      allow update: if isAdmin() ||
        (signedIn() && ownerFromCreatedBy(resource.data) && ownerFromCreatedBy(request.resource.data));
      allow delete: if isAdmin() ||
        (signedIn() && ownerFromCreatedBy(resource.data));
    }

    match /playlist_shares/{shareId} {
      allow get: if isAdmin() ||
        (signedIn() && resource.data.createdBy == request.auth.uid) ||
        (
          resource.data.isPublic == true &&
          resource.data.keys().hasAny(['playlistId']) &&
          get(/databases/$(database)/documents/playlists/$(resource.data.playlistId)).data.isPublic == true
        );
      allow list: if isAdmin();
      allow create: if signedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.isPublic == true;
      allow update, delete: if isAdmin() ||
        (signedIn() && resource.data.createdBy == request.auth.uid);
    }

    match /songs/{songId} {
      allow get: if signedIn() || isPublicCatalogDocument(resource.data);
      allow list: if isPublicCatalogDocument(resource.data);
      allow create, update, delete: if isAdmin();
    }

    match /albums/{albumId} {
      allow read: if isPublicCatalogDocument(resource.data);
      allow create, update, delete: if isAdmin();
    }

    match /trendingSongs/{songId} {
      allow read: if isPublicCatalogDocument(resource.data);
      allow create, update, delete: if isAdmin();
    }

    match /mood_playlist_cache/{docId} {
      allow read, write: if isAdmin();
    }

    match /mood_playlist_rate_limits/{docId} {
      allow read, write: if isAdmin();
    }

    match /mood_playlist_analytics/{docId} {
      allow read, write: if isAdmin();
    }

    match /mood_playlist_metrics/{docId} {
      allow read, write: if isAdmin();
    }

    match /mood_playlist_alerts/{docId} {
      allow read, write: if isAdmin();
    }

    match /promotions/{promotionId} {
      allow read: if isPublicPromotionDocument(resource.data);
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
